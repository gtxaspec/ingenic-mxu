+/* MXU3 vector modes are 512-bit (64 bytes).  Each VPR holds 4 quarters of
+   128-bit data; native operations work on one quarter at a time.  */
+#define UNITS_PER_MXU3_REG 64
+
+#define MXU3_SUPPORTED_MODE_P(MODE)			\
+  (ISA_HAS_MXU3					\
+   && GET_MODE_SIZE (MODE) == UNITS_PER_MXU3_REG	\
+   && (GET_MODE_CLASS (MODE) == MODE_VECTOR_INT		\
+       || GET_MODE_CLASS (MODE) == MODE_VECTOR_FLOAT))
+
