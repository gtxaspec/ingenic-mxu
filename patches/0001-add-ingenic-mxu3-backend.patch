@@ -1323,6 +1332,10 @@
 
 #define ISA_HAS_MXU2		(TARGET_MXU2 && !TARGET_MIPS16)
 
+/* MXU3 = 512-bit SIMD (XBurst2 only). MXU3.1 implies MXU3.  */
+#define ISA_HAS_MXU3		(TARGET_MXU3 && !TARGET_MIPS16)
+#define ISA_HAS_MXU3_1		(TARGET_MXU3_1 && ISA_HAS_MXU3)
+
 /* The MIPS16e V2 instructions are available.  */
 #define ISA_HAS_MIPS16E2       (TARGET_MIPS16 && TARGET_MIPS16E2 \
 				&& !TARGET_64BIT)
@@ -2493,6 +2506,16 @@
